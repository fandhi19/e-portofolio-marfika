  <!-- Scripts -->
  <script src="js/main.js"></script>
  <script>
    // Photo Lightbox modal handler
    const photoModal = document.getElementById('photo-modal');
    const photoClose = document.getElementById('photo-modal-close');
    const photoTitle = document.getElementById('photo-title');
    const photoBadge = document.getElementById('photo-badge');
    const photoLoc = document.getElementById('photo-loc');
    const photoDesc = document.getElementById('photo-desc');

    window.openPhotoModal = function(imgSrc, title, category, desc, location, label) {
      const modalImg = document.getElementById('photo-modal-img');
      const modalLink = document.getElementById('photo-modal-link');
      if (modalImg) modalImg.src = imgSrc;
      if (modalLink) modalLink.href = imgSrc;
      if (!photoModal) return;
      photoTitle.textContent = title;
      photoBadge.textContent = `${category} • ${label}`;
      photoLoc.innerHTML = `<i class="fa-solid fa-location-dot" style="margin-right:6px; color:#12382D;"></i> Lokasi: ${location}`;
      photoDesc.textContent = desc;

      photoModal.classList.add('active');
      document.body.style.overflow = 'hidden';
    };

    if (photoClose) {
      photoClose.addEventListener('click', () => {
        photoModal.classList.remove('active');
        document.body.style.overflow = '';
      });
    }

    if (photoModal) {
      photoModal.addEventListener('click', (e) => {
        if (e.target === photoModal) {
          photoModal.classList.remove('active');
          document.body.style.overflow = '';
        }
      });
    }
  </script>
</body>
