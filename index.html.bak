            <div class="service-card-media">
              <img src="https://images.unsplash.com/photo-1592656094267-764a45160876?auto=format&fit=crop&w=600&q=80" alt="Modul Bola Voli" onerror="this.src='https://placehold.co/600x350/0d2820/FFFFFF?text=Modul+Bola+Voli'">
