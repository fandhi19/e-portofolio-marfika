  <!-- =================================================================
       4. MAIN PROFILE CARD
       ================================================================= -->
  <main>
    <div class="container">
      <div class="profile-agency-card">
        <!-- Photo & Action -->
        <div style="text-align: center;">
          <div class="profile-agency-avatar">
            <img src="IMG/krisna.jpg" alt="Krisna Pratama Aulihar, S.Pd." onerror="this.onerror=null; this.src='Pas Foto.JPG';">
          </div>

          <div class="badge-pill-group" style="justify-content: center; margin-bottom: 1.25rem;">
            <span class="twin-dot-icon">
              <span></span><span></span>
            </span>
            <span>Status: PPL Terbimbing</span>
          </div>

          <button class="btn btn-primary-dark btn-sm" style="width: 100%;" onclick="showToast('Curriculum Vitae Krisna Pratama siap diunduh!')">
            <i class="fa-solid fa-file-pdf"></i> Unduh CV Lengkap
          </button>
        </div>

        <!-- Information Details -->
        <div>
          <div class="badge-pill-group" style="margin-bottom: 0.5rem;">
            <span class="twin-dot-icon">
              <span></span><span></span>
            </span>
            <span>Mahasiswa PPG Calon Guru Gelombang 1</span>
          </div>

          <h2 style="font-size: clamp(1.8rem, 3vw, 2.4rem); color: var(--color-primary-dark); margin-bottom: 0.4rem;">
            Krisna Pratama Aulihar, S.Pd.
          </h2>
          <p style="color: var(--color-accent-lime-hover); font-weight: 700; font-size: 1rem; margin-bottom: 1.25rem;">
            Guru Pendidikan Jasmani, Olahraga, dan Kesehatan (PJOK) • Calon Guru Profesional
          </p>

          <p style="font-size: 0.95rem; line-height: 1.7; color: var(--color-text-muted);">
            Lulusan S1 Pendidikan Kepelatihan Olahraga (PKO) Fakultas Ilmu Keolahragaan dan Kesehatan (FIKK) Universitas Negeri Yogyakarta yang saat ini sedang menempuh Program Pendidikan Profesi Guru (PPG) Calon Guru Bidang Studi PJOK. Memiliki keahlian dan lisensi resmi kepelatihan pada cabang olahraga Futsal, Pencak Silat, serta Pelatih Kondisi Fisik (Strength & Conditioning). Berdedikasi menghadirkan pembelajaran olahraga yang humanis, inklusif, berdiferensiasi, dan memanfaatkan teknologi TPACK di SMA N 3 Yogyakarta.
          </p>

          <!-- Bio Grid -->
          <div class="profile-bio-grid">
            <div class="bio-card-item">
              <div class="bio-label-text">Perguruan Tinggi LPTK</div>
              <div class="bio-value-text">Universitas Negeri Yogyakarta (UNY)</div>
            </div>
            <div class="bio-card-item">
              <div class="bio-label-text">Pendidikan Terakhir</div>
              <div class="bio-value-text">S1 Pendidikan Kepelatihan Olahraga (FIKK UNY)</div>
            </div>
            <div class="bio-card-item">
              <div class="bio-label-text">Sekolah Latihan PPL</div>
              <div class="bio-value-text">SMA N 3 Yogyakarta</div>
            </div>
            <div class="bio-card-item">
              <div class="bio-label-text">Fokus & Lisensi Pelatih</div>
              <div class="bio-value-text">Futsal, Pencak Silat, & Kondisi Fisik</div>
            </div>
          </div>

        </div>
      </div>
    </div>

    <!-- =================================================================
         5. SECTION FILOSOFI MENGAJAR
         ================================================================= -->
    <section style="padding: 5rem 0 4rem; background: #FFFFFF;">
      <div class="container">
        <div style="text-align: center; max-width: 700px; margin: 0 auto 3.5rem;">
          <div class="badge-pill-group" style="justify-content: center;">
            <span class="twin-dot-icon">
              <span></span><span></span>
            </span>
            <span>NILAI & DEDIKASI PEDAGOGIK</span>
          </div>
          <h2 style="font-size: clamp(1.8rem, 3vw, 2.4rem); color: var(--color-primary-dark); margin-bottom: 0.8rem;">
            Filosofi Mengajar Guru PJOK
          </h2>
          <p style="color: var(--color-text-muted);">
            Fondasi dan paradigma berpikir dalam membimbing tumbuh kembang fisik, mental, dan emosional peserta didik.
          </p>
        </div>

        <div class="cards-agency-grid">
          <!-- Card 1 -->
          <div class="card-agency">
            <div class="card-agency-header">
              <div class="card-agency-icon">
                <i class="fa-solid fa-heart-pulse"></i>
              </div>
              <span class="tag-pill" style="background: rgba(18,56,45,0.06); color: var(--color-primary-dark);">Physical Literacy</span>
            </div>
            <div class="card-agency-body">
              <h3 class="card-agency-title">Mendidik Melalui Gerak</h3>
              <p class="card-agency-desc">
                Pendidikan jasmani bukan semata-mata mencetak atlet prestasi, melainkan media holistik untuk mengembangkan kebugaran jasmani, kemampuan koordinasi motorik, dan kebiasaan hidup aktif sepanjang hayat (active lifestyle for lifetime).
              </p>
              <div class="card-agency-spec">
                <div class="card-agency-spec-title">Penerapan di Lapangan:</div>
                <ul>
                  <li>Pemanasan rekreatif berbasis permainan gerak</li>
                  <li>Monitoring intensitas melalui tes denyut nadi berkala</li>
                  <li>Pemberian pemahaman manfaat gerak bagi kesehatan organ tubuh</li>
                </ul>
              </div>
            </div>
          </div>

          <!-- Card 2 -->
          <div class="card-agency">
            <div class="card-agency-header">
              <div class="card-agency-icon">
                <i class="fa-solid fa-hands-holding-child"></i>
              </div>
              <span class="tag-pill" style="background: rgba(184,224,35,0.2); color: var(--color-primary-dark);">Diferensiasi</span>
            </div>
            <div class="card-agency-body">
              <h3 class="card-agency-title">Inklusif & Berdiferensiasi</h3>
              <p class="card-agency-desc">
                Setiap peserta didik memiliki kesiapan fisik dan modalitas gerak yang beraneka ragam. Modifikasi peraturan, ukuran bola, dan target capaian gerak menjamin seluruh siswa merasakan kegembiraan dan pengalaman sukses saat berolahraga.
              </p>
              <div class="card-agency-spec">
                <div class="card-agency-spec-title">Penerapan di Lapangan:</div>
                <ul>
                  <li>Variasi penggunaan bola busa ramah pemula dan bola standar</li>
                  <li>Penyesuaian tinggi net dan jarak servis bertahap</li>
                  <li>Umpan balik personal tanpa membandingkan antar siswa</li>
                </ul>
              </div>
            </div>
          </div>

          <!-- Card 3 -->
          <div class="card-agency">
            <div class="card-agency-header">
              <div class="card-agency-icon">
                <i class="fa-solid fa-shield-heart"></i>
              </div>
              <span class="tag-pill" style="background: rgba(18,56,45,0.06); color: var(--color-primary-dark);">Karakter Luhur</span>
            </div>
            <div class="card-agency-body">
              <h3 class="card-agency-title">Penguatan Karakter Pancasila</h3>
              <p class="card-agency-desc">
                Lapangan olahraga adalah laboratorium moral: kejujuran mengakui sentuhan bola keluar, sportivitas saat menang maupun kalah, kerjasama gotong royong, dan ketangguhan mental diasah secara langsung melalui aksi nyata.
              </p>
              <div class="card-agency-spec">
                <div class="card-agency-spec-title">Penerapan di Lapangan:</div>
                <ul>
                  <li>Refleksi emosi dan kejujuran di akhir tiap sesi permainan</li>
                  <li>Pergantian peran kapten tim secara bergilir untuk kepemimpinan</li>
                  <li>Tradisi saling berjabat tangan dan apresiasi lawan tanding</li>
                </ul>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- =================================================================
         6. SECTION RIWAYAT PENDIDIKAN & LISENSI
         ================================================================= -->
    <section style="padding: 5rem 0; background: var(--color-bg-subtle); border-top: 1px solid var(--color-border-light);">
      <div class="container">
        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 4rem;">
          
          <!-- Column 1: Riwayat Pendidikan -->
          <div>
            <div class="badge-pill-group">
              <span class="twin-dot-icon">
                <span></span><span></span>
              </span>
              <span>JEJAK AKADEMIK</span>
            </div>
            <h3 style="font-size: 2rem; color: var(--color-primary-dark); margin-bottom: 2rem;">
              Riwayat Pendidikan
            </h3>

            <div class="timeline-agency-wrap">
              <div class="timeline-agency-item">
                <span class="tag-pill" style="background: rgba(184, 224, 35, 0.25); color: var(--color-primary-dark); font-weight: 800;">
                  2025 - Sekarang
                </span>
                <h4 style="font-size: 1.15rem; color: var(--color-primary-dark); margin-top: 0.6rem; margin-bottom: 0.25rem;">
                  Program Pendidikan Profesi Guru (PPG) Calon Guru
                </h4>
                <div style="color: var(--color-accent-lime-hover); font-size: 0.9rem; font-weight: 700; margin-bottom: 0.5rem;">
                  Universitas Negeri Yogyakarta (UNY)
                </div>
                <p style="font-size: 0.88rem; color: var(--color-text-muted); line-height: 1.6;">
                  Mendalami perangkat ajar Kurikulum Merdeka, studi kasus pedagogik PJOK, serta Praktik Pengalaman Lapangan (PPL) Terbimbing dan Mandiri di sekolah mitra.
                </p>
              </div>

              <div class="timeline-agency-item">
                <span class="tag-pill" style="background: rgba(18, 56, 45, 0.08); color: var(--color-primary-dark); font-weight: 800;">
                  2020 - 2024
                </span>
                <h4 style="font-size: 1.15rem; color: var(--color-primary-dark); margin-top: 0.6rem; margin-bottom: 0.25rem;">
                  Sarjana Pendidikan (S.Pd.) - Pendidikan Kepelatihan Olahraga (PKO)
                </h4>
                <div style="color: var(--color-accent-lime-hover); font-size: 0.9rem; font-weight: 700; margin-bottom: 0.5rem;">
                  Fakultas Ilmu Keolahragaan & Kesehatan (FIKK) UNY
                </div>
                <p style="font-size: 0.88rem; color: var(--color-text-muted); line-height: 1.6;">
                  Lulus dengan predikat Pujian (Cum Laude). Fokus keilmuan metodologi kepelatihan olahraga, periodisasi latihan kondisi fisik (strength & conditioning), biomekanika gerak, serta analisis performa atlet Futsal dan Pencak Silat.
                </p>
              </div>
            </div>
          </div>

          <!-- Column 2: Sertifikasi & Lisensi -->
          <div>
            <div class="badge-pill-group">
              <span class="twin-dot-icon">
                <span></span><span></span>
              </span>
              <span>KOMPETENSI RESMI</span>
            </div>
            <h3 style="font-size: 2rem; color: var(--color-primary-dark); margin-bottom: 2rem;">
              Sertifikasi & Lisensi
            </h3>

            <div style="display: flex; flex-direction: column; gap: 1.25rem;">
              <div class="card-agency" style="padding: 1.5rem; flex-direction: row; align-items: center; gap: 1.25rem;">
                <div class="card-agency-icon" style="flex-shrink: 0;">
                  <i class="fa-solid fa-certificate"></i>
                </div>
                <div>
                  <h4 style="font-size: 1.05rem; color: var(--color-primary-dark); margin-bottom: 0.25rem;">
                    Sertifikat Pelatihan Kurikulum Merdeka & TPACK
                  </h4>
                  <p style="font-size: 0.84rem; color: var(--color-text-muted); margin-bottom: 0.4rem;">
                    Direktorat Jenderal Guru dan Tenaga Kependidikan & Universitas Negeri Yogyakarta
                  </p>
                  <span class="tag-pill" style="background: rgba(184, 224, 35, 0.2); color: var(--color-primary-dark);">Tahun 2025 • Terverifikasi</span>
                </div>
              </div>

              <div class="card-agency" style="padding: 1.5rem; flex-direction: row; align-items: center; gap: 1.25rem;">
                <div class="card-agency-icon" style="flex-shrink: 0;">
                  <i class="fa-solid fa-futbol"></i>
                </div>
                <div>
                  <h4 style="font-size: 1.05rem; color: var(--color-primary-dark); margin-bottom: 0.25rem;">
                    Lisensi Pelatih Futsal Nasional
                  </h4>
                  <p style="font-size: 0.84rem; color: var(--color-text-muted); margin-bottom: 0.4rem;">
                    Federasi Futsal Indonesia (FFI) & PSSI • Lisensi Kepelatihan Resmi
                  </p>
                  <span class="tag-pill" style="background: rgba(184, 224, 35, 0.2); color: var(--color-primary-dark);">Pelatih Futsal Berlisensi</span>
                </div>
              </div>

              <div class="card-agency" style="padding: 1.5rem; flex-direction: row; align-items: center; gap: 1.25rem;">
                <div class="card-agency-icon" style="flex-shrink: 0;">
                  <i class="fa-solid fa-hand-fist"></i>
                </div>
                <div>
                  <h4 style="font-size: 1.05rem; color: var(--color-primary-dark); margin-bottom: 0.25rem;">
                    Lisensi Pelatih Pencak Silat
                  </h4>
                  <p style="font-size: 0.84rem; color: var(--color-text-muted); margin-bottom: 0.4rem;">
                    Ikatan Pencak Silat Indonesia (IPSI) • Sertifikasi Kepelatihan Silat
                  </p>
                  <span class="tag-pill" style="background: rgba(184, 224, 35, 0.2); color: var(--color-primary-dark);">Pelatih Silat Berlisensi</span>
                </div>
              </div>

              <div class="card-agency" style="padding: 1.5rem; flex-direction: row; align-items: center; gap: 1.25rem;">
                <div class="card-agency-icon" style="flex-shrink: 0;">
                  <i class="fa-solid fa-dumbbell"></i>
                </div>
                <div>
                  <h4 style="font-size: 1.05rem; color: var(--color-primary-dark); margin-bottom: 0.25rem;">
                    Lisensi Pelatih Fisik (Strength & Conditioning Coach)
                  </h4>
                  <p style="font-size: 0.84rem; color: var(--color-text-muted); margin-bottom: 0.4rem;">
                    Asosiasi Pelatih Fisik Indonesia (APFI) & FIKK Universitas Negeri Yogyakarta
                  </p>
                  <span class="tag-pill" style="background: rgba(184, 224, 35, 0.2); color: var(--color-primary-dark);">Pelatih Kondisi Fisik Berlisensi</span>
                </div>
              </div>

              <div class="card-agency" style="padding: 1.5rem; flex-direction: row; align-items: center; gap: 1.25rem;">
                <div class="card-agency-icon" style="flex-shrink: 0;">
                  <i class="fa-solid fa-kit-medical"></i>
                </div>
                <div>
                  <h4 style="font-size: 1.05rem; color: var(--color-primary-dark); margin-bottom: 0.25rem;">
                    Pelatihan Penanganan Pertama Cedera Olahraga (P3K Lapangan)
                  </h4>
                  <p style="font-size: 0.84rem; color: var(--color-text-muted); margin-bottom: 0.4rem;">
                    Laboratorium Kesehatan & Fisiologi Olahraga Terapan FIKK UNY
                  </p>
                  <span class="tag-pill" style="background: rgba(184, 224, 35, 0.2); color: var(--color-primary-dark);">Kompetensi Medis Lapangan</span>
                </div>
              </div>
            </div>
          </div>

        </div>
